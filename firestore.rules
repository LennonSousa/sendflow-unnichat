rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.tenantId == request.auth.uid;
    }

    function ownsNewDocument() {
      return signedIn() && request.resource.data.tenantId == request.auth.uid;
    }

    function ownsConnection(connectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/connections/$(connectionId))
        && get(/databases/$(database)/documents/connections/$(connectionId)).data.tenantId == request.auth.uid;
    }

    match /connections/{connectionId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsExistingDocument() && ownsNewDocument();
    }

    match /contacts/{contactId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument() && ownsConnection(request.resource.data.connectionId);
      allow update: if ownsExistingDocument()
        && ownsNewDocument()
        && ownsConnection(resource.data.connectionId)
        && request.resource.data.connectionId == resource.data.connectionId;
    }

    match /messages/{messageId} {
      allow read: if ownsExistingDocument();
      allow write: if false;
    }
  }
}
